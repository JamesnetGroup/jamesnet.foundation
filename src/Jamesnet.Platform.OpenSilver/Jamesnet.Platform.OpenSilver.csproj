<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>13</LangVersion>
    <EnableDefaultItems>false</EnableDefaultItems>
    <DefineSilverlight>true</DefineSilverlight>
    <OpenSilverType>7</OpenSilverType>

    <AssemblyName>Jamesnet.Foundation</AssemblyName>
    <RootNamespace>Jamesnet.Foundation</RootNamespace>
    <Version>$(JamesnetVersion)</Version>
    <Product>Jamesnet.Foundation</Product>
    <IsPackable>false</IsPackable>

    <DefineConstants>$(DefineConstants);OPENSILVER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenSilver" Version="3.3.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\**\*.cs" LinkBase="Shared" Exclude="..\Shared\Core\InjectAttribute.cs" />
    <Compile Include="ContentCase.cs" />
    <Compile Include="IMobileView.cs" />
    <Compile Include="ContentSwitcher.cs" />
    <Compile Include="Scripts\DeviceInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <Page Include="Themes\Generic.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>

</Project>
