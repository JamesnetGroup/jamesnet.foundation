<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <LangVersion>13</LangVersion>

    <AssemblyName>Jamesnet.Foundation</AssemblyName>
    <RootNamespace>Jamesnet.Foundation</RootNamespace>
    <Version>$(JamesnetVersion)</Version>
    <Product>Jamesnet.Foundation</Product>
    <IsPackable>false</IsPackable>

    <DefineConstants>$(DefineConstants);WINUI3</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\**\*.cs" LinkBase="Shared" Exclude="..\Shared\Core\InjectAttribute.cs" />
  </ItemGroup>

</Project>
