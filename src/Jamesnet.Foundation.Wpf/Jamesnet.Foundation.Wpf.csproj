<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- 모든 flavor가 같은 어셈블리 이름/네임스페이스를 갖는다.
         소비자는 플랫폼과 무관하게 항상 Jamesnet.Foundation 하나만 본다. -->
    <AssemblyName>Jamesnet.Foundation</AssemblyName>
    <RootNamespace>Jamesnet.Foundation</RootNamespace>
    <Version>$(JamesnetVersion)</Version>
    <Product>Jamesnet.Foundation</Product>

    <!-- 패키징은 Jamesnet.Foundation.Package 프로젝트가 전담한다. -->
    <IsPackable>false</IsPackable>

    <DefineConstants>$(DefineConstants);WPF</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\**\*.cs" LinkBase="Shared" Exclude="..\Shared\Core\InjectAttribute.cs" />
  </ItemGroup>

</Project>
