<Project Sdk="Uno.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-desktop</TargetFrameworks>
    <UnoSingleProject>true</UnoSingleProject>
    <OutputType>Library</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GenerateLibraryLayout>true</GenerateLibraryLayout>

    <AssemblyName>Jamesnet.Foundation</AssemblyName>
    <RootNamespace>Jamesnet.Foundation</RootNamespace>
    <Version>$(JamesnetVersion)</Version>
    <Product>Jamesnet.Foundation</Product>
    <IsPackable>false</IsPackable>

    <DefineConstants>$(DefineConstants);UNO</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\**\*.cs" LinkBase="Shared" Exclude="..\Shared\Core\InjectAttribute.cs" />
  </ItemGroup>

</Project>
