<Project Sdk="Microsoft.NET.Sdk">

  <!--
    소비자가 받는 단 하나의 패키지. 코드는 없고, flavor 프로젝트들의 산출물을
    한 상자에 모으는 역할만 한다.
  -->

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <PackageId>Jamesnet.Foundation</PackageId>
    <Version>$(JamesnetVersion)</Version>
    <Product>Jamesnet.Foundation</Product>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- NU5128: lib에 어셈블리가 없음, NU5100: flavors\가 lib\ 밖에 있음.
         둘 다 이 패키지의 의도된 구조다. 참조는 buildTransitive의 targets가 붙인다. -->
    <NoWarn>$(NoWarn);NU5128;NU5100</NoWarn>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDependencyFile>false</GenerateDependencyFile>

    <!--
      패키지에 담을 flavor 목록.

      uwp는 레거시 non-SDK 프로젝트라 `dotnet build`로는 빌드할 수 없고
      Visual Studio의 MSBuild + UWP 워크로드가 필요하다. 그래서 기본 목록에서
      빠져 있을 뿐, 폐기된 것이 아니다. UWP 툴체인이 있는 환경에서는
      -p:JamesnetFlavors="wpf;opensilver;winui3;uno;uwp" 로 함께 담는다.

      배포용 패키지는 반드시 전체 flavor로 만들어야 한다.
    -->
    <JamesnetFlavors Condition="'$(JamesnetFlavors)' == ''">wpf;opensilver;winui3;uno</JamesnetFlavors>
  </PropertyGroup>

  <ItemGroup>
    <!-- flavor 자동 선택 로직 -->
    <None Include="buildTransitive\Jamesnet.Foundation.targets" Pack="true" PackagePath="buildTransitive\" />

    <!-- lib에는 DLL을 두지 않는다. 호환성 표식만 두고 실제 참조는 targets가 붙인다. -->
    <None Include="_._" Pack="true" PackagePath="lib\netstandard2.0\" />

    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- flavor 정의: 이름 -> 프로젝트, 산출물 경로 -->
  <ItemGroup>
    <JamesnetFlavor Include="wpf">
      <Project>..\Jamesnet.Platform.WPF\Jamesnet.Platform.WPF.csproj</Project>
      <Dll>..\Jamesnet.Platform.WPF\bin\$(Configuration)\net10.0-windows\Jamesnet.Foundation.dll</Dll>
    </JamesnetFlavor>
    <JamesnetFlavor Include="opensilver">
      <Project>..\Jamesnet.Platform.OpenSilver\Jamesnet.Platform.OpenSilver.csproj</Project>
      <Dll>..\Jamesnet.Platform.OpenSilver\bin\$(Configuration)\netstandard2.0\Jamesnet.Foundation.dll</Dll>
    </JamesnetFlavor>
    <JamesnetFlavor Include="winui3">
      <Project>..\Jamesnet.Platform.WinUI3\Jamesnet.Platform.WinUI3.csproj</Project>
      <Dll>..\Jamesnet.Platform.WinUI3\bin\$(Configuration)\net10.0-windows10.0.19041.0\Jamesnet.Foundation.dll</Dll>
    </JamesnetFlavor>
    <JamesnetFlavor Include="uno">
      <Project>..\Jamesnet.Platform.Uno\Jamesnet.Platform.Uno.csproj</Project>
      <Dll>..\Jamesnet.Platform.Uno\bin\$(Configuration)\net10.0-desktop\Jamesnet.Foundation.dll</Dll>
    </JamesnetFlavor>
    <JamesnetFlavor Include="uwp">
      <Project>..\Jamesnet.Platform.UWP\Jamesnet.Platform.Uwp.csproj</Project>
      <Dll>..\Jamesnet.Platform.UWP\bin\$(Configuration)\Jamesnet.Foundation.dll</Dll>
    </JamesnetFlavor>
  </ItemGroup>

  <!-- 요청된 flavor만 골라낸다. -->
  <Target Name="SelectJamesnetFlavors">
    <ItemGroup>
      <_Requested Include="$(JamesnetFlavors)" />
      <_Selected Include="@(JamesnetFlavor)" Condition="'%(Identity)' != ''" />
      <_Selected Remove="@(_Selected)" Condition="!$([System.String]::new(';$(JamesnetFlavors);').Contains(';%(Identity);'))" />
    </ItemGroup>

    <Error Condition="@(_Selected->Count()) != @(_Requested->Count())"
           Text="알 수 없는 flavor가 JamesnetFlavors에 있습니다: '$(JamesnetFlavors)'. 사용 가능한 값: @(JamesnetFlavor, ', ')" />

    <Message Importance="high" Text="Jamesnet.Foundation 패키지에 담을 flavor: @(_Selected, ', ')" />
    <Warning Condition="@(_Selected->Count()) != @(JamesnetFlavor->Count())"
             Code="JAMESNETPACK001"
             Text="전체 flavor(@(JamesnetFlavor, ', ')) 중 일부만 담깁니다. 배포용 패키지라면 누락된 flavor의 툴체인이 있는 환경에서 다시 pack하세요." />
  </Target>

  <!-- 선택된 flavor를 빌드한다.
       ProjectReference 대신 MSBuild 태스크를 쓰는 이유는, TFM이 서로 달라
       (net10.0-windows / netstandard2.0 / net10.0-desktop ...) 일반 참조로는
       호환성 검사에 걸리기 때문이다. -->
  <Target Name="BuildJamesnetFlavors" DependsOnTargets="SelectJamesnetFlavors" BeforeTargets="CollectJamesnetFlavors">
    <MSBuild Projects="%(_Selected.Project)"
             Targets="Build"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="TargetFramework;TargetFrameworks;RuntimeIdentifier" />
  </Target>

  <Target Name="CollectJamesnetFlavors" DependsOnTargets="SelectJamesnetFlavors" BeforeTargets="GenerateNuspec">
    <Error Condition="!Exists('%(_Selected.Dll)')"
           Text="flavor '%(_Selected.Identity)' 산출물이 없습니다: %(_Selected.Dll)" />

    <ItemGroup>
      <!-- flavor DLL을 pack의 변경 감지 입력에 넣는다. 빠지면 DLL이 바뀌어도 예전 nupkg가 그대로 남는다. -->
      <NuGetPackInput Include="%(_Selected.Dll)" />
      <_PackageFiles Include="%(_Selected.Dll)">
        <PackagePath>flavors\%(_Selected.Identity)\</PackagePath>
        <BuildAction>None</BuildAction>
      </_PackageFiles>
    </ItemGroup>
  </Target>

</Project>
