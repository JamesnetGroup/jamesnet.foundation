<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Jamesnet.Foundation</id>
    <version>$version$</version>
    <authors>Jaewung Lee, Yang Qu</authors>
    <owners>JamesnetGroup</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="file">LICENSE</license>
    <readme>README.md</readme>
    <projectUrl>https://github.com/JamesnetGroup/jamesnet.foundation</projectUrl>
    <repository type="git" url="https://github.com/JamesnetGroup/jamesnet.foundation" commit="$commit$" />
    <description>XAML-based application foundation with platform implementations for WPF, OpenSilver, WinUI 3, and UWP.</description>
    <summary>One Jamesnet.Foundation package for supported XAML platforms.</summary>
    <releaseNotes>Preview of the unified Jamesnet.Foundation package. Do not publish as a stable package until all platform validation gates pass.</releaseNotes>
    <copyright>Copyright © 2025 JamesnetGroup</copyright>
    <tags>jamesnet xaml wpf opensilver winui3 uwp mvvm cross-platform</tags>
    <dependencies>
      <group targetFramework="netstandard2.0">
        <dependency id="System.Text.Json" version="8.0.5" exclude="Build,Analyzers" />
        <dependency id="OpenSilver" version="3.2.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net8.0-windows">
        <dependency id="System.Text.Json" version="8.0.5" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net8.0-windows10.0.19041.0">
        <dependency id="System.Text.Json" version="8.0.5" exclude="Build,Analyzers" />
        <dependency id="Microsoft.WindowsAppSDK" version="1.5.240311000" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Windows.SDK.BuildTools" version="10.0.22621.756" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="uap10.0">
        <dependency id="System.Text.Json" version="8.0.5" exclude="Build,Analyzers" />
        <dependency id="Microsoft.NETCore.UniversalWindowsPlatform" version="6.2.14" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="LICENSE" target="" />
    <file src="README.md" target="" />

    <file src="src\Jamesnet.Foundation\bin\Release\netstandard2.0\Jamesnet.Foundation.dll" target="lib\netstandard2.0" />
    <file src="src\Jamesnet.Platform.OpenSilver\bin\Release\netstandard2.0\Jamesnet.Platform.OpenSilver.dll" target="lib\netstandard2.0" />

    <file src="src\Jamesnet.Foundation\bin\Release\netstandard2.0\Jamesnet.Foundation.dll" target="lib\net8.0-windows" />
    <file src="src\Jamesnet.Platform.WPF\bin\Release\net8.0-windows\Jamesnet.Platform.WPF.dll" target="lib\net8.0-windows" />

    <file src="src\Jamesnet.Foundation\bin\Release\netstandard2.0\Jamesnet.Foundation.dll" target="lib\net8.0-windows10.0.19041.0" />
    <file src="src\Jamesnet.Platform.WinUI3\bin\Release\net8.0-windows10.0.19041.0\Jamesnet.Platform.WinUI3.dll" target="lib\net8.0-windows10.0.19041.0" />

    <file src="src\Jamesnet.Foundation\bin\Release\netstandard2.0\Jamesnet.Foundation.dll" target="lib\uap10.0" />
    <file src="src\Jamesnet.Platform.UWP\bin\Release\Jamesnet.Platform.Uwp.dll" target="lib\uap10.0" />
  </files>
</package>
